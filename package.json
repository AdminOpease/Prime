{
  "name": "primebodywork",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:cf": "rm -rf .next .open-next && next build --webpack && opennextjs-cloudflare build --skipNextBuild",
    "deploy:cf": "opennextjs-cloudflare deploy",
    "preview:cf": "opennextjs-cloudflare preview",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "studio:deploy": "sanity deploy"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd"
    ]
  },
  "dependencies": {
    "@portabletext/react": "^6.2.0",
    "@portabletext/types": "^4.0.2",
    "@sanity/image-url": "^2.1.1",
    "@sentry/nextjs": "^10.53.1",
    "next": "16.2.6",
    "next-sanity": "^12.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.9",
    "@sanity/vision": "^5.25.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "sanity": "~5.24.0",
    "styled-components": "^6.4.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.90.1"
  }
}
