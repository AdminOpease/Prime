# Public build-time env vars for production.
#
# These are all NEXT_PUBLIC_* prefixed, which means Next.js bakes them into
# the browser bundle at build time — they're NOT secret, they're visible
# to any user who inspects the site. Safe (and required) to commit.
#
# Actual secrets (RESEND_API_KEY, CONTACT_FORM_TO_EMAIL) stay in Cloudflare's
# runtime env vars — never committed.

NEXT_PUBLIC_SANITY_PROJECT_ID=8z0je8p3
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
NEXT_PUBLIC_SENTRY_DSN=https://49eb521beb9fb83a1a3fe8003a3fa13a@o4511389928062976.ingest.de.sentry.io/4511390725242960

# Cloudflare Turnstile site key (public). The matching TURNSTILE_SECRET_KEY
# is a Cloudflare runtime secret — never committed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEQGV7q882diWL3F
